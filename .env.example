# Copy this file to `.env` and fill in real values.
# Never commit a real `.env` to version control.

# Shared webhook + admin access tokens. Generate strong random values,
# e.g. `openssl rand -hex 32`. Tokens equal to any placeholder are rejected
# with a warning at startup.
CMJR_WEBHOOK_TOKEN=change-this-token
CMJR_ADMIN_TOKEN=change-this-admin-token

# Maximum accepted webhook payload size in bytes.
CMJR_MAX_PAYLOAD_BYTES=100000

# Inbound provider: generic | meta (Meta WhatsApp Business Platform Cloud API)
CMJR_PROVIDER=generic

# --- Meta WhatsApp Business Platform Cloud API credentials ---
# Only used when CMJR_PROVIDER=meta. Incomplete credentials log a startup
# warning; inbound messages are still acknowledged (HTTP 200) to avoid
# provider retries, but outbound replies fail.
CMJR_META_APP_ID=
CMJR_META_APP_SECRET=
CMJR_META_VERIFY_TOKEN=
CMJR_META_ACCESS_TOKEN=
CMJR_META_PHONE_NUMBER_ID=
CMJR_META_API_VERSION=v25.0
CMJR_META_GRAPH_URL=https://graph.facebook.com

# --- AI advisory layer ---
# AI is NEVER authoritative. The deterministic rules remain final. If AI is
# unreachable or returns garbage, the bot silently falls back to rules.
# The model is asked to detect abuse in ANY language (groups are multilingual)
# and may trigger deletion for high-confidence toxic/harassment/adult content
# that the wordlists cannot catch. It reports the detected language and an
# English translation of the flagged phrase.
# Values: none | local | ollama
#
#   none    - no AI (deterministic only, fully offline)
#   ollama  - free local model at CMJR_AI_URL (e.g. http://127.0.0.1:11434)
#   local   - any OpenAI-compatible endpoint (free cloud APIs, 24x7):
#             Google Gemini (Google AI Studio free tier, strong multilingual):
#               CMJR_AI_URL=https://generativelanguage.googleapis.com/v1beta/openai/chat/completions
#               CMJR_AI_MODEL=gemini-3.6-flash
#             Groq (free tier, works in all regions):
#               CMJR_AI_URL=https://api.groq.com/openai
#               CMJR_AI_MODEL=openai/gpt-oss-120b
#             OpenRouter:
#               CMJR_AI_URL=https://openrouter.ai/api/v1
#               CMJR_AI_MODEL=meta-llama/llama-3.3-70b-instruct:free
CMJR_AI_PROVIDER=none
# Base URL of the AI server. Ollama appends /api/generate; the local provider
# appends /v1/chat/completions (OpenAI-compatible). Set a full .../chat/completions
# URL when the provider does not use standard /v1 paths (e.g. Gemini).
CMJR_AI_URL=http://127.0.0.1:11434
CMJR_AI_MODEL=
# API key for the local/OpenAI-compatible provider (free providers need one).
CMJR_AI_API_KEY=
# Request timeout in milliseconds (default 5000; raise for cold cloud starts).
CMJR_AI_TIMEOUT=5000

# --- Automatic enforcement ---
# should_delete / should_block / should_kick request bridge actions.
# Warnings are always recorded; auto-* gates what is executed without an admin.
# When AUTO_DELETE=true:
#   - Link messages are deleted automatically UNLESS the sender is an
#     approved member (PUT /admin/users/{sender}/approved {"approved": true}).
#   - Harmful content / bad words are deleted for EVERYONE, approved or not.
CMJR_AUTO_DELETE=false
CMJR_AUTO_WARN=true
CMJR_AUTO_BLOCK=false
CMJR_AUTO_KICK=false

# --- Spam detection tuning ---
CMJR_SPAM_WINDOW_SECONDS=10
CMJR_SPAM_MAX_MESSAGES=5
CMJR_SPAM_SIMILARITY_THRESHOLD=0.90

# --- Behavior engine ---
# Number of warnings before a user is flagged as a repeat offender.
CMJR_WARNING_THRESHOLD=3

# --- Link policy ---
# ALLOW_ALL | REVIEW_UNKNOWN | BLOCK_SUSPICIOUS | BLOCK_ALL_EXTERNAL | ALLOW_TRUSTED_ONLY
CMJR_DEFAULT_LINK_POLICY=REVIEW_UNKNOWN

# --- Trusted sender numbers ---
# Comma-separated WhatsApp numbers (with country code, no "+").
# OWNER > ADMIN > MODERATOR > TRUSTED. Empty = no trusted senders.
CMJR_OWNER_NUMBERS=
CMJR_ADMIN_NUMBERS=
CMJR_MODERATOR_NUMBERS=
CMJR_TRUSTED_NUMBERS=
# Users (numbers) allowed to send external links regardless of policy.
CMJR_TRUSTED_LINK_SENDERS=